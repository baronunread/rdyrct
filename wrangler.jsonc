{
  "$schema": ".vscode/wrangler-schema.json",
  "name": "rdyrct",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-01-01",
  // global_fetch_strictly_public: required by the MCP OAuth plugin's CIMD
  // client-metadata fetch (better-auth.ts) — the Worker cannot pin a DNS
  // resolution itself, so the platform does the SSRF-hardening (rejects any
  // non-public-routable address) and our fetch wrapper only has to refuse
  // redirects on top of it.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker first for everything except the hashed bundle under /assets/.
    // The custom-domain redirect, /:slug, the per-page head
    // (page-meta.ts) and the security-header baseline all have to see a
    // request before an asset could answer it, and a slug is any
    // single-segment path, so no pattern separates "a short link" from "a
    // page" ahead of the KV lookup — that's why the exception stops at
    // /assets/* rather than covering every static file.
    //
    // Two known gaps from the exception, both accepted: a request to
    // /assets/* on a custom domain no longer gets the redirect-only 404 (no
    // session cookie ever reaches a custom domain, so this is cosmetic, not
    // a data leak), and a chunk deleted by a later deploy comes back as the
    // SPA shell under a 200 instead of the 404 serveSpa used to produce,
    // same as any SPA's normal stale-chunk behavior.
    //
    // Cache-Control and the security-header baseline for what Cloudflare serves
    // directly now live in public/_headers instead of serveSpa
    // (src/worker/index.ts): Cloudflare documents _headers as applying to what
    // it serves directly, and with the Worker no longer in front of these
    // requests, that's exactly what's happening. _headers can't tell a real
    // chunk from a deleted one either, so the SPA-shell response above gets
    // cached too — measured against the real built Worker, not just reasoned
    // about, which is why public/_headers caps it at a day with must-revalidate
    // instead of the year a content hash would otherwise justify.
    //
    // Every exclusion after !/assets/* is a known root file. Listing it spares
    // an isolate wake (and the slug lookup behind it) on every crawler hit and
    // share preview; the price is one rule here and one in public/_headers.
    // An excluded path can never be a slug, which for these names is fine:
    // slugs on the shared domain are random, none of them looks like this.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/og.png",
      "!/email-logo.png",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/llms.txt",
      "!/llms-full.txt",
      "!/ai.txt",
    ],
  },
  // The ids are rdyrct.com's. A fork's `bun run setup` (scripts/setup.ts)
  // removes them, and Wrangler creates the fork's own resources on its first
  // deploy. Local dev works with these.
  "kv_namespaces": [
    {
      "binding": "LINKS",
      "id": "aa2cec55f8964d0fba2c23e1e3b5fea1",
    },
  ],
  // User-supplied images (QR logos, avatars); D1 rows store only the serving
  // URL (see routes/qr-logos.ts, routes/avatars.ts).
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "rdyrct-qr-logos",
    },
  ],
  // Secrets (wrangler secret put …): BETTER_AUTH_SECRET, SUPERADMIN_EMAIL,
  // RESEND_API_KEY, POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET, CF_API_TOKEN.
  // Local dev reads everything from .dev.vars (see .dev.vars.local.example).
  "vars": {
    "APP_URL": "https://rdyrct.com",
    "APP_HOST": "rdyrct.com",
    // No SHARED_LINK_HOST here on purpose. It is set per deployment, as a
    // secret, once its domain is attached and resolving
    // (`wrangler secret put SHARED_LINK_HOST`). Committed, it would switch
    // every new link to a host that may not exist yet, on this deploy and on
    // every fork of the repo. Unset, shared links use APP_HOST.
    "MAIL_FROM": "rdyrct <no-reply@mail.rdyrct.com>",
    // The founder's welcome email is sent from this address. Forks leave it unset.
    "WELCOME_FROM": "Andrea at rdyrct <andrea@mail.rdyrct.com>",
    // Newsletters go out from this address, on a subdomain of their own so a
    // marketing complaint cannot hurt sign-in mail. Verify the domain in
    // Resend first. Unset (forks), a newsletter send is refused.
    "NEWSLETTER_FROM": "Andrea at rdyrct <andrea@news.rdyrct.com>",
    // news.rdyrct.com receives no mail: replies go to the inbox Email Routing serves.
    "NEWSLETTER_REPLY_TO": "andrea@mail.rdyrct.com",
    // The postal address in every newsletter's footer (CAN-SPAM asks for one
    // when mailing US recipients). The same one the site shows (shared/business.ts).
    "POSTAL_ADDRESS": "Andrea Bruno, Viale Gabriele D'Annunzio 23, 34138 Trieste (TS), Italy",
    // "production" or "sandbox" — the SDK maps this to the API base URL.
    "POLAR_SERVER": "production",
    "POLAR_PRO_PRODUCT_ID": "5837e285-85c3-4d38-8557-a7b2bdc3b98d",
    "POLAR_HOBBY_PRODUCT_ID": "60a69be5-ff21-4523-82ab-b6c466772724",
    // Yearly products, priced 10% below twelve months. Create in Polar, then
    // paste the ids here.
    "POLAR_PRO_YEARLY_PRODUCT_ID": "69d9d016-8c57-4a0d-a9dd-acc492149462",
    "POLAR_HOBBY_YEARLY_PRODUCT_ID": "f96a3dde-4741-4f7c-a998-29e9adab1c81",
    "CF_ZONE_ID": "21285955570c1215ae9efd13692c950a",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rdyrct",
      "database_id": "cff7eb6e-ee69-4c94-8d51-6ad09de5afd9",
      "migrations_dir": "migrations",
    },
  ],
  // KV/R2 follow-up work off the redirect hot path (issue #16). A storage-queue
  // send is awaited after committing D1; a producer-side failure is recorded to
  // storage_outbox rather than failing the request (#118, #227). Give-ups land
  // on the DLQ, which this same Worker also consumes (see the `queue()`
  // handler) to record and alert. `bun run setup` creates both queues.
  // Keep max_retries here in sync with STORAGE_MAX_DELIVERIES (storage.ts).
  // Click ingestion is NOT a queue: it buffers in the ClickBuffer Durable
  // Object and flushes to D1 on an alarm (#225, see durable_objects below).
  "queues": {
    "producers": [
      {
        "binding": "STORAGE_QUEUE",
        "queue": "rdyrct-storage",
      },
    ],
    "consumers": [
      {
        "queue": "rdyrct-storage",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "rdyrct-storage-dlq",
      },
      {
        "queue": "rdyrct-storage-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
  // Click ingestion (#225). One instance, addressed idFromName("clicks"): every
  // redirect calls add(), a ~10 s alarm flushes the buffer to D1 in one batch.
  // SQLite-backed so it runs on the Workers Free plan.
  "durable_objects": {
    "bindings": [
      {
        "name": "CLICK_BUFFER",
        "class_name": "ClickBuffer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ClickBuffer"],
    },
  ],
  // Durable, per-step-retried background processes: org teardown (ordered
  // cleanup) and custom-domain activation (CF hostname create + DNS/TLS polling
  // off the request path).
  "workflows": [
    {
      "binding": "ORG_DELETE",
      "name": "rdyrct-org-delete",
      "class_name": "OrgDeleteWorkflow",
    },
    {
      "binding": "DOMAIN_ACTIVATE",
      "name": "rdyrct-domain-activate",
      "class_name": "DomainActivateWorkflow",
    },
    {
      "binding": "LINK_IMPORT",
      "name": "rdyrct-link-import",
      "class_name": "LinkImportWorkflow",
    },
    {
      "binding": "NEWSLETTER_SEND",
      "name": "rdyrct-newsletter-send",
      "class_name": "NewsletterSendWorkflow",
    },
  ],
  // The limits are RATE_LIMITS in src/worker/rate-limit.ts; this is their
  // shared pool. Changing namespace_id resets every counter.
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "14011",
      "simple": {
        "limit": 1800,
        "period": 60,
      },
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  // "0 6 * * *": the daily batch (trim old clicks, sweeps, grace warnings, and
  // a storage_outbox drain). "*/10 * * * *": drain storage_outbox only, so a
  // transient STORAGE_QUEUE send failure recovers in minutes rather than
  // waiting for the daily pass (#228). The scheduled() handler switches on the
  // cron string; only "0 6 * * *" runs the daily batch.
  "triggers": {
    "crons": ["0 6 * * *", "*/10 * * * *"],
  },
  // Browser tests select this environment so Wrangler loads
  // .dev.vars.playwright instead of a developer's local values. Resource
  // identifiers are local-only placeholders, never production identifiers.
  "env": {
    "playwright": {
      "vars": {
        "APP_URL": "http://localhost:5174",
        "APP_HOST": "localhost:5174",
        "SHARED_LINK_HOST": "rdyr.cc",
        "MAIL_FROM": "rdyrct <no-reply@localhost>",
        "WELCOME_FROM": "Andrea at rdyrct <andrea@localhost>",
        "NEWSLETTER_FROM": "Andrea at rdyrct <news@localhost>",
        "NEWSLETTER_REPLY_TO": "andrea@localhost",
        "POSTAL_ADDRESS": "rdyrct, 1 Example Street, 00100 Rome, Italy",
        "POLAR_SERVER": "sandbox",
        "POLAR_PRO_PRODUCT_ID": "playwright_pro_product",
        "POLAR_HOBBY_PRODUCT_ID": "playwright_hobby_product",
        "POLAR_PRO_YEARLY_PRODUCT_ID": "playwright_pro_yearly_product",
        "POLAR_HOBBY_YEARLY_PRODUCT_ID": "playwright_hobby_yearly_product",
        "CF_ZONE_ID": "",
        // "instant", not "1": the e2e suite asserts a domain reaches active,
        // so the staged DNS/TLS delays local dev shows off would only be a
        // timer for the test to race.
        "CF_DEV_ENV": "instant",
        // Flush clicks after 0.5 s, not 10: a test that follows a click to
        // D1 should not spend a sixth of its timeout waiting on an alarm.
        "CLICK_FLUSH_MS": "500",
      },
      "kv_namespaces": [
        {
          "binding": "LINKS",
          "id": "00000000000000000000000000000001",
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "rdyrct-playwright-local",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rdyrct-playwright",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "STORAGE_QUEUE",
            "queue": "rdyrct-playwright-storage",
          },
        ],
        "consumers": [
          {
            "queue": "rdyrct-playwright-storage",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 30,
            "dead_letter_queue": "rdyrct-playwright-storage-dlq",
          },
          {
            "queue": "rdyrct-playwright-storage-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 30,
          },
        ],
      },
      // A named env inherits neither block from the top level once it sets its
      // own queues/workflows, so the click buffer is repeated here.
      "durable_objects": {
        "bindings": [
          {
            "name": "CLICK_BUFFER",
            "class_name": "ClickBuffer",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ClickBuffer"],
        },
      ],
      "workflows": [
        {
          "binding": "ORG_DELETE",
          "name": "rdyrct-playwright-org-delete",
          "class_name": "OrgDeleteWorkflow",
        },
        {
          "binding": "DOMAIN_ACTIVATE",
          "name": "rdyrct-playwright-domain-activate",
          "class_name": "DomainActivateWorkflow",
        },
        {
          "binding": "LINK_IMPORT",
          "name": "rdyrct-playwright-link-import",
          "class_name": "LinkImportWorkflow",
        },
        {
          "binding": "NEWSLETTER_SEND",
          "name": "rdyrct-playwright-newsletter-send",
          "class_name": "NewsletterSendWorkflow",
        },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "24011",
          "simple": {
            "limit": 1800,
            "period": 60,
          },
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
