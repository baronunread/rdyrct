# Copy to .dev.vars (gitignored) for local dev.

BETTER_AUTH_SECRET=dev-only-secret-change-in-prod
SUPERADMIN_EMAIL=you@example.com
APP_URL=https://rdyrct.localhost
APP_HOST=rdyrct.localhost

# Email: point at the emulate.dev Resend emulator (bun run mail)
RESEND_API_KEY=re_local_emulated
RESEND_BASE_URL=https://mail.rdyrct.localhost
MAIL_FROM=rdyrct <no-reply@localhost>

# Polar (sandbox): https://sandbox.polar.sh
POLAR_ACCESS_TOKEN=polar_oat_replace_me
POLAR_WEBHOOK_SECRET=polar_whs_replace_me
POLAR_PRO_PRODUCT_ID=replace_me
POLAR_HOBBY_PRODUCT_ID=replace_me
POLAR_SERVER=sandbox

# Custom domains: leave CF_API_TOKEN blank and CF_DEV_ENV=simulated to fake the
# Cloudflare API locally (fails closed with both blank). "simulated" walks a new
# domain through checking_dns and issuing_tls on a timer so you can watch both
# states; "instant" reports them ready at once, which is what the e2e run uses.
CF_API_TOKEN=
CF_ZONE_ID=
CF_DEV_ENV=simulated

# Sentry: error capture (worker errors + dead-lettered storage/click alerts).
# Leave blank to no-op locally (nothing sent from dev/test).
SENTRY_DSN=

# rdyrct-blog: run its dev server (bun run dev in that repo) and /blog here
# proxies to it. Leave blank to skip the proxy.
BLOG_ORIGIN_URL=http://localhost:3000

# Cap proof-of-work (#98). In production this is `openssl rand -hex 32`; the
# fixed value here is deliberate, so the real challenge/solve/redeem loop runs
# instead of the disabled path. Note .dev.vars.playwright sets its own: that
# is the file the browser suite reads, and a value only here would leave every
# e2e signup on the disabled path. The disabled path has its own worker test,
# which needs no browser to prove it.
CAP_SECRET=dev-only-cap-secret-not-a-real-one-0000000000000000
