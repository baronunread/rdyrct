# Copy to .dev.vars (gitignored) for local dev.

BETTER_AUTH_SECRET=dev-only-secret-change-in-prod
SUPERADMIN_EMAIL=you@example.com
APP_URL=https://rdyrct.localhost
APP_HOST=rdyrct.localhost
SHARED_LINK_HOST=rdyrct.localhost

# Email: point at the emulate.dev Resend emulator (bun run mail)
RESEND_API_KEY=re_local_emulated
RESEND_BASE_URL=https://mail.rdyrct.localhost
MAIL_FROM=rdyrct <no-reply@localhost>

# Polar (sandbox): https://sandbox.polar.sh
POLAR_ACCESS_TOKEN=polar_oat_replace_me
POLAR_WEBHOOK_SECRET=polar_whs_replace_me
POLAR_PRO_PRODUCT_ID=replace_me
POLAR_HOBBY_PRODUCT_ID=replace_me
POLAR_SERVER=sandbox

# Custom domains: leave CF_API_TOKEN blank and CF_DEV_ENV=simulated to fake the
# Cloudflare API locally (fails closed with both blank). "simulated" walks a new
# domain through checking_dns and issuing_tls on a timer so you can watch both
# states; "instant" reports them ready at once, which is what the e2e run uses.
CF_API_TOKEN=
CF_ZONE_ID=
CF_DEV_ENV=simulated

# Sentry: error capture (worker errors + dead-lettered storage/click alerts).
# Leave blank to no-op locally (nothing sent from dev/test).
SENTRY_DSN=

# rdyrct-blog: run its dev server (bun run dev in that repo) and /blog here
# proxies to it. Leave blank to skip the proxy.
BLOG_ORIGIN_URL=http://localhost:3000

# Cloudflare Turnstile (#304). These are Cloudflare's published test keys
# (always pass), so the real widget and verify loop run locally with no
# account. In production, create a widget in the Cloudflare dashboard and set
# TURNSTILE_SITE_KEY as a var in wrangler.jsonc and TURNSTILE_SECRET_KEY as a
# secret. Leave the secret blank to turn the check off.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google sign-in. Leave all three blank to hide the "Continue with Google"
# button. For local dev, `bun run dev` starts the emulate google service
# behind portless at https://google.emulate.localhost, so the values below
# work as-is (the client id/secret are arbitrary, the emulator accepts any).
# It's seeded from google.emulate.yaml with two accounts: testuser@gmail.com
# (a regular account) and admin@gmail.com. Set SUPERADMIN_EMAIL above to the
# latter to test the platform admin locally through the emulator.
# In production, leave GOOGLE_EMULATOR_URL blank and set the real Google
# OAuth client id/secret; the worker then uses Google's discovery URL.
GOOGLE_CLIENT_ID=test-client
GOOGLE_CLIENT_SECRET=test-secret
GOOGLE_EMULATOR_URL=https://google.emulate.localhost
