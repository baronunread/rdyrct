VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Public Sentry DSN for browser error reports. Vite reads it when you run
# `bun run build` or `bun run deploy`. Set it in the build environment for CI.
# It identifies the project but cannot read Sentry data. Leave blank to disable it.
VITE_PUBLIC_SENTRY_DSN=

# evlog — wide event delivery
SENTRY_DSN="" # project DSN
