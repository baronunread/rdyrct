# Production secrets for `wrangler secret bulk`.
# Copy to prod.secrets.env (gitignored), fill in the values, then:
#
#   bunx wrangler secret bulk prod.secrets.env && rm prod.secrets.env
#
# Local dev does NOT use this file — it reads .dev.vars instead.
# Non-sensitive config (APP_URL, MAIL_FROM, POLAR_SERVER, ids) stays in wrangler.jsonc vars.

# BetterAuth session signing. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The account with this email becomes the platform admin (/admin).
SUPERADMIN_EMAIL=you@example.com

# https://resend.com/api-keys (production key — RESEND_BASE_URL stays unset in prod)
RESEND_API_KEY=

# https://polar.sh → Settings → Access Tokens (sandbox.polar.sh while POLAR_SERVER=sandbox)
# Required scopes: checkouts:write, customer_sessions:write
POLAR_ACCESS_TOKEN=

# Polar → Webhooks → endpoint https://rdyrct.com/api/webhooks/polar
# Required events: subscription.active, subscription.revoked,
# subscription.canceled, subscription.uncanceled
# Copy the signing secret here.
POLAR_WEBHOOK_SECRET=

# dash.cloudflare.com → My Profile → API Tokens → custom token:
# permission Zone → SSL and Certificates → Edit, scoped to your zone (custom domains)
CF_API_TOKEN=

# Cloudflare Turnstile in front of signup, password reset, the landing
# shortener and the report form (#304). dash.cloudflare.com → Turnstile →
# Add widget (managed mode, your app host as the hostname). The site key is
# public (the browser gets it from /api/config) but lives here rather than in
# wrangler.jsonc so a fork does not inherit it. Set both or neither, in this
# one bulk call: leave both blank and the check is off and the browser never
# loads Cloudflare's script; either key without the other refuses every
# guarded form and logs turnstile_misconfigured.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Web Risk Lookup API (#341): checks every destination on create and
# edit, and live free-plan links weekly; a listed link is held. Create a key at
# console.cloud.google.com → APIs & Services → Credentials, with the Web Risk
# API enabled and the key restricted to it. Free up to 100,000 lookups a month;
# confirm the commercial terms before turning it on. Leave unset and only the
# Cloudflare DNS check runs.
WEB_RISK_API_KEY=

# Google sign-in (#194). Create an OAuth 2.0 client at
# console.cloud.google.com → APIs & Services → Credentials, with authorized
# redirect URI https://rdyrct.com/api/auth/callback/google.
# Leave both blank and the "Continue with Google" button never shows.
# GOOGLE_EMULATOR_URL stays unset in prod (dev-only); the worker then uses
# Google's discovery URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
