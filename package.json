{
  "name": "rdyrct",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "trap 'kill 0' INT TERM; portless rdyrct vite dev & bun run mail & bunx emulate start --service google --portless --port 4001 --seed google.emulate.yaml & wait",
    "mail": "portless mail.rdyrct bunx emulate --service resend",
    "polar:listen": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" polar listen https://rdyrct.localhost/api/webhooks/polar",
    "build": "vite build && bun scripts/prerender-public.tsx && bun scripts/prerender-404.tsx",
    "preview": "vite preview",
    "check": "bun check && bun check -p tsconfig.worker.json && bun check -p tests/worker/tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:worker:self-host": "VITE_RDYRCT_SITE=0 vitest run --config vitest.config.ts tests/worker/self-host.worker.ts",
    "e2e:install": "playwright install chromium",
    "e2e:smoke": "playwright test",
    "e2e:self-host": "playwright test --config playwright.self-host.config.ts",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test && bun run test:worker && bun run test:worker:self-host",
    "verify:e2e": "bun run verify && bun run e2e:smoke",
    "posthog:upload": "POSTHOG_CLI_PROJECT_ID=${POSTHOG_CLI_PROJECT_ID:-240147} posthog-cli --host ${POSTHOG_CLI_HOST:-https://eu.posthog.com} sourcemap process --directory dist/client/assets --release-name rdyrct --delete-after",
    "deploy": "bun scripts/deploy.ts",
    "setup": "bun scripts/setup.ts",
    "db:migrate:local": "wrangler d1 migrations apply rdyrct --local",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/kv && wrangler d1 migrations apply rdyrct --local",
    "db:migrate:remote": "wrangler d1 migrations apply rdyrct --remote",
    "db:seed:local": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" bun scripts/seed-local.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "doctor": "react-doctor",
    "fallow": "fallow audit --base origin/main",
    "check:observability": "evlog map --min-score 100",
    "style": "style-doctor --scope changed --base origin/main"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/mcp": "^0.3.2",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@polar-sh/sdk": "^1.0.2",
    "@sentry/cloudflare": "^11.6.0",
    "@sentry/react": "^11.6.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-charts": "1.1.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "better-auth": "1.7.7",
    "blobatar": "^2.7.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "cobe": "2.0.1",
    "d3-geo": "^3.1.1",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "evlog": "2.30.1",
    "hono": "^4.13.13",
    "iso-3166-1": "^2.1.1",
    "jose": "6.2.12",
    "marked": "^18.1.0",
    "morphicons": "^1.7.1",
    "motion": "^13.4.0",
    "posthog-js": "^1.438.7",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.90.0",
    "shadow-plugin": "^2.1.1",
    "standardwebhooks": "^1.1.1",
    "sugar-high": "^2.6.0",
    "svgo": "^4.1.0",
    "topojson-client": "^3.1.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "5.20260927.1",
    "@evlog/cli": "0.9.0",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.0",
    "@posthog/cli": "^0.18.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "bun-types": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "fallow": "3.33.1",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "lefthook": "^2.2.1",
    "oxlint": "1.87.0",
    "portless": "^0.15.7",
    "react-doctor": "^0.9.17",
    "style-doctor": "0.4.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "zod": "4.6.5"
  },
  "packageManager": "bun@1.4.4",
  "cloudflare": {
    "bindings": {
      "SUPERADMIN_EMAIL": {
        "description": "The account that signs up with this email becomes the platform admin."
      },
      "APP_URL": {
        "description": "Leave as it is. The first deploy points your copy at its `workers.dev` address. To use your own domain later, see the [README](https://github.com/baronunread/rdyrct#move-to-your-own-domain)."
      },
      "APP_HOST": {
        "description": "Leave as it is, like `APP_URL`."
      },
      "MAIL_FROM": {
        "description": "rdyrct.com's sender. Your copy drops it until you set `APP_HOST` yourself. Email needs a [Resend](https://resend.com) key too."
      },
      "WELCOME_FROM": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_SERVER": {
        "description": "Billing, which is off on your copy unless you set up [Polar](https://polar.sh). Your copy drops rdyrct.com's values."
      },
      "POLAR_PRO_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_HOBBY_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_PRO_YEARLY_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_HOBBY_YEARLY_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "CF_ZONE_ID": {
        "description": "rdyrct.com's. Your copy drops it. Customers' own domains need your zone and an API token."
      },
      "SENTRY_DSN": {
        "description": "rdyrct.com's error reports. Your copy drops it, so nothing reaches our Sentry."
      }
    }
  },
  "trustedDependencies": [
    "@posthog/cli"
  ]
}
