{
  "name": "rdyrct",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "portless rdyrct vite dev",
    "mail": "portless mail.rdyrct bunx emulate --service resend",
    "polar:listen": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" polar listen https://rdyrct.localhost/api/webhooks/polar",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:worker": "vitest run --config vitest.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:smoke": "playwright test",
    "verify": "bun run format:check && bun run lint && bun run check && bunx tsc -p tsconfig.worker.json --noEmit && bunx tsc -p tests/worker/tsconfig.json --noEmit && bun run test && bun run test:worker",
    "verify:e2e": "bun run verify && bun run e2e:smoke",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rdyrct --local",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/kv && wrangler d1 migrations apply rdyrct --local",
    "db:migrate:remote": "wrangler d1 migrations apply rdyrct --remote",
    "db:seed:local": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" bun scripts/seed-local.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "doctor": "react-doctor",
    "fallow": "fallow audit --base origin/main"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cap.js/wasm": "^0.0.7",
    "@cap.js/widget": "^0.1.57",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@polar-sh/sdk": "^0.49.0",
    "@sentry/cloudflare": "^10.70.0",
    "@sentry/react": "^10.71.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/charts": "^0.14.0",
    "@tanstack/react-charts": "^0.14.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.31",
    "better-auth": "^1.7.1",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "capjs-core": "0.1.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "iso-3166-1": "^2.1.1",
    "morphicons": "^1.7.0",
    "motion": "^13.1.1",
    "posthog-js": "1.418.10",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "shadow-plugin": "^2.1.0",
    "standardwebhooks": "^1.0.0",
    "svgo": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.0",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "fallow": "3.17.0",
    "jsqr": "^1.4.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "1.79.0",
    "portless": "^0.15.5",
    "react-doctor": "^0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "packageManager": "bun@1.3.4"
}
