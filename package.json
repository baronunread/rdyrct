{
  "name": "rdyrct",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "polar:listen": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" sh -c 'polar listen \"$(bun scripts/dev-hosts.ts app)/api/webhooks/polar\"'",
    "build": "vite build && bun scripts/prerender-app-shell.tsx && bun scripts/prerender-public.tsx && bun scripts/prerender-404.tsx",
    "check": "bun check && bun check -p tsconfig.worker.json && bun check -p tests/worker/tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:worker:self-host": "VITE_RDYRCT_SITE=0 vitest run --config vitest.config.ts tests/worker/self-host.worker.ts",
    "e2e:install": "playwright install chromium",
    "e2e:smoke": "playwright test",
    "e2e:production": "playwright test --config playwright.production.config.ts",
    "e2e:shard-times": "bun scripts/e2e-shard-times.ts",
    "e2e:self-host": "playwright test --config playwright.self-host.config.ts",
    "verify": "bun run format:check && bun run lint && bun run check && bun run test && bun run test:worker && bun run test:worker:self-host",
    "verify:e2e": "bun run verify && bun run e2e:smoke && bun run e2e:production",
    "posthog:upload": "POSTHOG_CLI_PROJECT_ID=${POSTHOG_CLI_PROJECT_ID:-240147} posthog-cli --host ${POSTHOG_CLI_HOST:-https://eu.posthog.com} sourcemap process --directory dist/client/assets --release-name rdyrct --delete-after",
    "deploy": "bun scripts/deploy.ts",
    "setup": "bun scripts/setup.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/kv && wrangler d1 migrations apply DB --local",
    "db:seed:local": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" bun scripts/seed-local.ts",
    "check:contrast": "bun scripts/check-contrast.ts",
    "doctor": "react-doctor",
    "fallow": "fallow audit --base origin/main",
    "check:observability": "evlog map --min-score 100",
    "style": "style-doctor --scope changed --base origin/main",
    "showcase:shots": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" bun scripts/showcase-shots.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.27",
    "@better-auth/mcp": "1.7.27",
    "@better-auth/oauth-provider": "1.7.27",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/mcp": "^0.3.5",
    "@hookform/resolvers": "^7.0.8",
    "@lobehub/icons-static-svg": "1.104.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@polar-sh/sdk": "^1.3.2",
    "@react-email/editor": "^1.8.10",
    "@sentry/cloudflare": "^11.16.0",
    "@sentry/react": "^11.16.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-charts": "1.5.0",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-router": "^1.170.46",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "better-auth": "1.7.27",
    "blobatar": "^2.7.0",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "circle-flags": "^2.8.3",
    "cmdk": "^1.1.1",
    "cn": "0.5.2",
    "d3-geo": "^3.1.2",
    "d3-shape": "^3.2.1",
    "drizzle-orm": "^0.45.4",
    "evlog": "2.37.0",
    "hono": "^4.13.19",
    "iso-3166-1": "^2.1.1",
    "jose": "6.2.18",
    "marked": "^18.2.1",
    "morphicons": "^2.0.2",
    "motion": "^14.14.0",
    "posthog-js": "^1.453.2",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.5",
    "react-hook-form": "^7.92.0",
    "shadow-plugin": "^2.1.1",
    "standardwebhooks": "^1.3.0",
    "sugar-high": "^2.7.0",
    "svgo": "^4.1.0",
    "topojson-client": "^3.1.0",
    "typegpu": "0.12.10",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@evlog/cli": "0.13.0",
    "@oxlint/plugins": "1.94.0",
    "@playwright/test": "^1.65.1",
    "@posthog/cli": "^0.20.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "emulate": "0.14.0",
    "fallow": "3.45.0",
    "jsonc-parser": "^3.3.1",
    "jsqr": "^1.4.0",
    "lefthook": "^2.2.2",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "portless": "^0.18.1",
    "react-doctor": "^0.9.23",
    "style-doctor": "0.5.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "packageManager": "bun@1.4.4",
  "cloudflare": {
    "bindings": {
      "SUPERADMIN_EMAIL": {
        "description": "The account that signs up with this email becomes the platform admin."
      },
      "APP_URL": {
        "description": "Leave as it is. The first deploy points your copy at its `workers.dev` address. To use your own domain later, see the [README](https://github.com/baronunread/rdyrct#move-to-your-own-domain)."
      },
      "APP_HOST": {
        "description": "Leave as it is, like `APP_URL`."
      },
      "MAIL_FROM": {
        "description": "rdyrct.com's sender. Your copy drops it until you set `APP_HOST` yourself. Email needs a [Resend](https://resend.com) key too."
      },
      "WELCOME_FROM": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "NEWSLETTER_FROM": {
        "description": "rdyrct.com's. Your copy drops it, and so sends no newsletter."
      },
      "POLAR_SERVER": {
        "description": "Billing, which is off on your copy unless you set up [Polar](https://polar.sh). Your copy drops rdyrct.com's values."
      },
      "POLAR_PRO_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_HOBBY_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_PRO_YEARLY_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "POLAR_HOBBY_YEARLY_PRODUCT_ID": {
        "description": "rdyrct.com's. Your copy drops it."
      },
      "CF_ZONE_ID": {
        "description": "rdyrct.com's. Your copy drops it. Customers' own domains need your zone and an API token."
      }
    }
  },
  "patchedDependencies": {
    "typegpu@0.12.10": "patches/typegpu@0.12.10.patch"
  },
  "trustedDependencies": [
    "@posthog/cli"
  ]
}
