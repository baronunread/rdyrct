{
  "name": "rdyrct",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless rdyrct vite dev",
    "mail": "portless mail.rdyrct bunx emulate --service resend",
    "polar:listen": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" polar listen https://rdyrct.localhost/api/webhooks/polar",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "lint": "oxlint src scripts tests vite.config.ts --deny-warnings",
    "lint:fix": "oxlint src scripts tests vite.config.ts --fix",
    "format": "oxfmt --write src scripts tests package.json vite.config.ts wrangler.jsonc README.md",
    "format:check": "oxfmt --check src scripts tests package.json vite.config.ts wrangler.jsonc README.md",
    "test": "bun test",
    "test:worker": "vitest run --config vitest.config.ts",
    "e2e:install": "playwright install chromium",
    "e2e:smoke": "playwright test",
    "verify": "bun run check && bunx tsc -p tsconfig.worker.json --noEmit && bun run lint && bun run format:check && bun run test && bun run test:worker && bun run e2e:smoke",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply rdyrct --local",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/kv && wrangler d1 migrations apply rdyrct --local",
    "db:migrate:remote": "wrangler d1 migrations apply rdyrct --remote",
    "db:seed:local": "NODE_EXTRA_CA_CERTS=\"$HOME/.portless/ca.pem\" bun scripts/seed-local.ts",
    "doctor": "react-doctor",
    "fallow": "fallow audit --base origin/main"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@polar-sh/sdk": "^0.48.1",
    "@tanstack/charts": "^0.6.4",
    "@tanstack/react-charts": "^0.6.4",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.25",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "iso-3166-1": "^2.1.1",
    "lucide": "^1.30.0",
    "lucide-react": "^1.28.0",
    "morphicons": "^1.2.0",
    "motion": "^12.43.0",
    "posthog-js": "^1.407.2",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-router": "^8.3.0",
    "shadow-plugin": "^1.2.7",
    "standardwebhooks": "^1.0.0",
    "svgo": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.4",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "fallow": "^3.11.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.76.0",
    "portless": "^0.15.5",
    "react-doctor": "^0.9.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "packageManager": "bun@1.3.4"
}
